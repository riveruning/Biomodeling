# Copy to .env in the directory where you run biomodel-agent.
# Use your provider's versioned base URL, not /chat/completions.
BIOMODEL_BASE_URL=https://YOUR_PROVIDER/v1
BIOMODEL_MODEL=YOUR_MODEL
BIOMODEL_API_KEY=YOUR_API_KEY

# Existing process environment variables take precedence over this file.
# Values are literal: shell commands and ${VARIABLE} expansion are not used.
