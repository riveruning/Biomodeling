+                raise RecoveryBlocked('malformed_recovery_object')
+            if not isinstance(payload, dict) or payload.get('execution_ref') != execution_ref:
+                continue
+            if envelope['kind'] not in ('agent_invocation', 'agent_run', 'agent_recovery'):
