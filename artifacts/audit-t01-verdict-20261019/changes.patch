+    draft = ModelDraft('decay', (State('x', 1.),), (Parameter('d', .5),),
+                       rate_rules=(RateRule('x', '-d*x'),))
+    evidence = [{'target': target, 'source_ref': source_ref, 'page': 1, 'quote': quote}
+                for target, quote in zip(('x/initial', 'd/value', 'rule:x/expression'), quotes)]
+    return source_ref, [{'action': 'submit_draft', 'args': {'draft': to_dict(draft), 'evidence': evidence}},
+                        {'action': 'run', 'args': {}}, {'action': 'finish', 'args': {}}]
