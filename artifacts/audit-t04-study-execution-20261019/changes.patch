+def _bounded_worker(target, payload, deadline):
+    """Budget includes spawn/wait; reap before returning or propagating a crash."""
+    ctx = mp.get_context('spawn')
+    out = ctx.Queue()
+    process = ctx.Process(target=target, args=(payload, out), daemon=True)
+    started = False
