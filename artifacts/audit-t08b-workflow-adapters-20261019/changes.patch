+@pytest.fixture
+def adapters():
+    spec = importlib.util.spec_from_file_location('workflow_adapters_acceptance',ROOT/'benchmarks/development/workflow_adapters.py')
+    module = importlib.util.module_from_spec(spec); spec.loader.exec_module(module)
+    return module
